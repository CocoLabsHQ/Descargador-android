<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema claro. Los colores de la interfaz (paleta elegida) se aplican desde el código. -->
    <style name="Theme.Descargador" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/icon_fondo</item>
        <item name="android:colorPrimaryDark">@color/icon_fondo</item>
        <item name="android:windowBackground">@color/splash</item>
        <item name="android:statusBarColor">@color/icon_fondo</item>
    </style>
    <!-- Tema oscuro (diálogos, desplegables y textos por defecto en oscuro) -->
    <style name="Theme.DescargadorOscuro" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/icon_fondo</item>
        <item name="android:colorPrimaryDark">@color/icon_fondo</item>
        <item name="android:windowBackground">@color/splash</item>
        <item name="android:statusBarColor">@color/icon_fondo</item>
    </style>
</resources>
